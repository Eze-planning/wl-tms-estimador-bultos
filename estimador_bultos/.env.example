# Proyecto BigQuery
BQ_PROJECT=tu-proyecto-gcp

# Dataset BigQuery
BQ_DATASET=sandbox

# Ruta al archivo de credenciales de GCP
BQ_KEY_PATH=bq_service_account.json

# Secreto para el endpoint de Cloud Scheduler (/cron/rebuild-base-embalaje)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET=

# Clave secreta para firmar JWT de autenticación (mínimo 32 caracteres)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Credenciales Valgreti (solo para el scraper)
VALGRETI_USER=tu-usuario
VALGRETI_PASS=tu-contraseña

# GitHub: auto-commit de users.json al crear/editar/eliminar usuarios
# Crear en: GitHub → Settings → Developer settings → Personal access tokens
# Permisos requeridos: Contents (Read and write) en el repo
GITHUB_TOKEN=
GITHUB_REPO=Eze-planning/wl-tms-estimador-bultos
GITHUB_BRANCH=master